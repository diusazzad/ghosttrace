# Environment Configuration Template for GhostTrace
# COPY THIS FILE TO .env.local FOR LOCAL DEVELOPMENT.
# NEVER COMMIT .env.local OR REAL API KEYS TO VERSION CONTROL.

# AI Providers
# Backboard API Key for Gemma 2 remote access (Optional for offline/local mode)
BACKBOARD_API_KEY=your_backboard_api_key_here

# Local Ollama endpoint for Gemma 2 (Default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434
GEMMA_MODEL_NAME=gemma2:9b

# Observability & Tracing (Hacktoberfest Partner Track: Sentry Agent Tracing)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development

# Database / Persistent Storage (Hacktoberfest Partner Track: MongoDB Atlas)
MONGODB_URI=
MONGODB_DB_NAME=ghosttrace_dev

# Application Settings
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Identity & Access Management (Hacktoberfest Partner Track: Auth0 for AI Agents - SDK v4)
# AUTH0_DOMAIN must be a hostname ONLY (e.g. tenant.us.auth0.com) without https://, paths, or trailing slashes.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_SECRET=your_auth0_session_secret_32_bytes_min
APP_BASE_URL=http://localhost:3000

# Auth0 Dashboard Configuration Reference:
# - Allowed Callback URLs: http://localhost:3000/auth/callback (and https://<production-domain>/auth/callback)
# - Allowed Logout URLs: http://localhost:3000 (and https://<production-domain>)
