# Environment Configuration Template for GhostTrace
# COPY THIS FILE TO .env.local FOR LOCAL DEVELOPMENT.
# NEVER COMMIT .env.local OR REAL API KEYS TO VERSION CONTROL.

# AI Providers
# Backboard API Key for Gemma 2 remote access (Optional for offline/local mode)
BACKBOARD_API_KEY=your_backboard_api_key_here

# Local Ollama endpoint for Gemma 2 (Default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434
GEMMA_MODEL_NAME=gemma2:9b

# Observability & Tracing (Hacktoberfest Partner Track: Sentry Agent Tracing)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development

# Database / Persistent Storage (Hacktoberfest Partner Track)
MONGODB_URI=
MONGODB_DB_NAME=ghosttrace_dev

# Application Settings
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
